# === OCCB backend · DEV (solo desarrollo local) ===
# Genera valores reales con: ./scripts/gen-secrets.sh dev
# La DB y Caddy viven en OTROS proyectos; aquí solo se configura cómo
# alcanzarlos.

APP_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Puertos publicados en el HOST (loopback / borde dev). Cambia si chocan
# con otro stack (p.ej. BACKEND_PORT=8001 POSTGRES_PORT=5433 ...).
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Postgres 18 + pgvector (satélite DB en red occb-dev).
POSTGRES_DB=occb_db
POSTGRES_USER=occb_app
POSTGRES_PASSWORD=changeme-dev-only-usa-gen-secrets
POSTGRES_PORT=5432
# URL para uso LOCAL (cargo run / psql). Dentro de compose se usa host "db".
DATABASE_URL=postgres://occb_app:changeme-dev-only-usa-gen-secrets@127.0.0.1:5432/occb_db

# Redis (opcional; vacío = rate-limit en memoria).
REDIS_PASSWORD=changeme-redis-dev-only
# URL para uso LOCAL. Dentro de compose se usa host "redis".
REDIS_URL=redis://:changeme-redis-dev-only@127.0.0.1:6379

# JWT (mín. 32 caracteres). Generar: openssl rand -base64 48
JWT_SECRET=dev-only-secret-min-32-chars-0123456789abcdef
JWT_ISSUER=occb-dev
JWT_AUDIENCE=occb-frontend-dev
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Orígenes permitidos (el frontend vive en OTRO proyecto).
CORS_ORIGINS=http://localhost:3000,http://localhost
FRONTEND_URL=http://localhost:3000

BODY_LIMIT_MB=1
RATE_LIMIT_PER_MINUTE=120
# Detrás de Caddy: confía en X-Forwarded-For (último salto).
TRUSTED_PROXY=true

# === Email (SMTP) · EXTERNOS FASE 1 ===
# Con EMAIL_ENABLED=false (defecto) los endpoints de envío devuelven 503
# sin tocar la red. Para dev local: Mailpit/Mailhog en :1025 sin auth.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notificaciones@localhost

# === Uploads (documentos) · EXTERNOS FASE 1 ===
# Default /tmp/uploads: el contenedor corre con FS de solo lectura y solo
# /tmp es escribible. En prod, montar un volumen (p.ej. uploads:/data/uploads)
# y fijar UPLOAD_DIR=/data/uploads.
UPLOAD_DIR=/tmp/uploads
# Tope por archivo en multipart (el límite global HTTP es 12 MB mínimo).
MAX_FILE_SIZE_MB=10

# === OAuth providers (opcionales) · EXTERNOS FASE 1 ===
# Solo se usan en FASE 2 (calendar/integraciones); vacíos = deshabilitados.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_SECRET=

# === Cifrado de tokens OAuth · EXTERNOS FASE 1 ===
# Base64 de 32 bytes exactos. Opcional en dev (warn), OBLIGATORIA en prod.
# Generar: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# URL pública del backend (callbacks OAuth, enlaces en emails).
BACKEND_URL=http://localhost:8000

RUST_LOG=occb_backend=debug,tower_http=info
