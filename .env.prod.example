# === OCCB backend · PROD (plantilla; NUNCA valores reales en git) ===
# 1. cp .env.prod.example .env.prod
# 2. Rellena con secretos generados:
#      JWT_SECRET: openssl rand -base64 48   (mín. 32 chars, sin "changeme")
# La DB y Caddy viven en OTROS proyectos; aquí solo se configura cómo
# alcanzarlos (nombres de servicio/host según tu red Docker).

APP_ENV=production

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Postgres 18 + pgvector (proyecto de base de datos).
DATABASE_URL=postgres://occb_app:OBLIGATORIO@db:5432/occb_db

# Redis (opcional; vacío = rate-limit en memoria).
REDIS_URL=

JWT_SECRET=OBLIGATORIO-generar-con-openssl-rand-base64-48
JWT_ISSUER=occb-prod
JWT_AUDIENCE=occb-frontend-prod
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Origen del frontend (proyecto separado). SIN localhost aquí.
CORS_ORIGINS=https://app.tudominio.com
FRONTEND_URL=https://app.tudominio.com

BODY_LIMIT_MB=1
RATE_LIMIT_PER_MINUTE=120
TRUSTED_PROXY=true

RUST_LOG=info
