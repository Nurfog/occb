# === OCCB backend · PROD (plantilla; NUNCA valores reales en git) ===
# 1. cp .env.prod.example .env.prod
# 2. Rellena con secretos generados:
#      JWT_SECRET: openssl rand -base64 48   (mín. 32 chars, sin "changeme")
# La DB y Caddy viven en OTROS proyectos; aquí solo se configura cómo
# alcanzarlos (nombres de servicio/host según tu red Docker).

APP_ENV=production

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Postgres 18 + pgvector (proyecto de base de datos).
DATABASE_URL=postgres://occb_app:OBLIGATORIO@db:5432/occb_db

# Redis (opcional; vacío = rate-limit en memoria).
REDIS_URL=

JWT_SECRET=OBLIGATORIO-generar-con-openssl-rand-base64-48
JWT_ISSUER=occb-prod
JWT_AUDIENCE=occb-frontend-prod
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Origen del frontend (proyecto separado). SIN localhost aquí.
CORS_ORIGINS=https://app.tudominio.com
FRONTEND_URL=https://app.tudominio.com

BODY_LIMIT_MB=1
RATE_LIMIT_PER_MINUTE=120
TRUSTED_PROXY=true

# === Email (SMTP) ===
# Con EMAIL_ENABLED=false los envíos devuelven 503 sin tocar la red.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notificaciones@tudominio.com

# === Uploads (documentos) ===
# Montar un volumen (p.ej. uploads:/data/uploads) y fijar aquí su path.
# El contenedor corre con FS de solo lectura.
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=10

# === OAuth providers (opcionales; vacíos = deshabilitados) ===
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_SECRET=

# === Cifrado de tokens OAuth ===
# Base64 de 32 bytes exactos. OBLIGATORIA en prod (el arranque falla sin ella).
# Generar: openssl rand -base64 32 (gen-secrets.sh ya la genera).
TOKEN_ENCRYPTION_KEY=

# URL pública del backend (callbacks OAuth, enlaces en emails).
BACKEND_URL=https://api.tudominio.com

RUST_LOG=info
